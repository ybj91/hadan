{
  "id": "morning-news",
  "version": 1,
  "enabled": true,
  "trigger": {
    "type": "cron",
    "expression": "0 8 * * *",
    "timezone": "Asia/Shanghai"
  },
  "assigned_agent_id": "vps-agent",
  "task": {
    "goal": "Summarize important news from the last 24 hours and deliver a digest"
  },
  "delivery_capability": "channel.telegram.send"
}
